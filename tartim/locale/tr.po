msgstr "pyserial bulunamadı. Pardus'ta kurmak için: sudo apt install python3-serial"

msgid "Could not open {port}: {error}"
msgstr "{port} açılamadı: {error}"

msgid ""
"You do not have permission to use the port. Add your user to the dialout group:\n"
"  sudo usermod -aG dialout $USER   (then log out and back in)"
msgstr ""
"Porta erişim izniniz yok. Kullanıcınızı dialout grubuna ekleyin:\n"
"  sudo usermod -aG dialout $USER   (ardından oturumu kapatıp açın)"

msgid "No"
msgstr "No"

msgid "Received at"
msgstr "Kayıt zamanı"

msgid "Bluetooth sockets are not supported on this system."
msgstr "Bu sistemde Bluetooth soketleri desteklenmiyor."

msgid "channel {channel}: {error}"
msgstr "kanal {channel}: {error}"

msgid "Could not connect to {address} over Bluetooth ({errors})."
msgstr "{address} adresine Bluetooth ile bağlanılamadı ({errors})."

msgid ""
"Turn the device on and pair it first in the Bluetooth section of the system "
"settings (the PIN is usually 0000 or 1234)."
msgstr ""
"Cihazı açın ve önce sistem ayarlarındaki Bluetooth bölümünden eşleştirin "
"(PIN genellikle 0000 ya da 1234)."

msgid "Classic (serial port)"
msgstr "Klasik (seri port)"

msgid "BLE (standard scale)"
msgstr "BLE (standart tartı)"

msgid "Bluetooth needs python3-gi: sudo apt install python3-gi"
msgstr "Bluetooth için python3-gi gerekli: sudo apt install python3-gi"

msgid "Could not connect to the system D-Bus: {error}"
msgstr "Sistem D-Bus'ına bağlanılamadı: {error}"

msgid "No Bluetooth adapter found. Does this computer have Bluetooth?"
msgstr "Bluetooth adaptörü bulunamadı. Bilgisayarınızda Bluetooth var mı?"

msgid "Bluetooth is off. Turn it on in the system settings."
msgstr "Bluetooth kapalı. Sistem ayarlarından Bluetooth'u açın."

msgid "No permission to use Bluetooth: {error}"
msgstr "Bluetooth erişim izni yok: {error}"

msgid "Another Bluetooth operation is in progress; try again shortly."
msgstr "Başka bir Bluetooth işlemi sürüyor, biraz sonra tekrar deneyin."

msgid "Could not connect to the device: {error}. Make sure it is on and nearby."
msgstr "Cihaza bağlanılamadı: {error}. Cihazın açık ve yakında olduğundan emin olun."

msgid ""
"This device does not use the standard Bluetooth scale service, so it cannot "
"be read directly yet. If you send a “Device report”, we can add support."
msgstr ""
"Bu cihaz standart Bluetooth tartı servisini kullanmıyor; henüz doğrudan "
"okuyamıyoruz. “Cihaz raporu” ile rapor gönderirseniz destek ekleyebiliriz."

msgid "Weight (kg)"
msgstr "Kilo (kg)"

msgid "Body fat (%)"
msgstr "Yağ oranı (%)"

msgid "Fat mass (kg)"
msgstr "Yağ kütlesi (kg)"

msgid "Muscle mass (kg)"
msgstr "Kas kütlesi (kg)"

msgid "Bone mass (kg)"
msgstr "Kemik kütlesi (kg)"

msgid "Total body water (%)"
msgstr "Toplam vücut suyu (%)"

msgid "Basal metabolic rate (kcal)"
msgstr "Bazal metabolizma hızı (kcal)"

msgid "Gender (1: male, 2: female)"
msgstr "Cinsiyet (1: erkek, 2: kadın)"

msgid "Height (cm)"
msgstr "Boy (cm)"

msgid "Clothes weight / tare (kg)"
msgstr "Kıyafet ağırlığı / dara (kg)"

msgid "RS-232 (with a USB-serial adapter)"
msgstr "RS-232 (USB-seri çevirici ile)"

msgid "USB (direct)"
msgstr "USB (doğrudan)"

msgid "SD card file"
msgstr "SD kart dosyası"

msgid "Send to the project server (no account needed)"
msgstr "Proje sunucusuna gönder (hesap gerekmez)"

msgid "I will send it myself with the GitHub form"
msgstr "GitHub formuyla kendim göndereceğim"

msgid "Do not send now, keep the file on my computer"
msgstr "Şimdilik gönderme, dosya bilgisayarımda kalsın"

msgid "You must confirm that the measurement does not belong to a real client."
msgstr "Ölçümün gerçek bir danışana ait olmadığını onaylamanız gerekir."

msgid "The report format was not recognised."
msgstr "Rapor biçimi tanınmadı."

msgid "The device model is missing."
msgstr "Cihaz modeli eksik."

msgid "The measurement list is not valid."
msgstr "Ölçüm listesi geçersiz."

msgid "The note must be text."
msgstr "Not metin olmalı."

msgid "The request was not valid."
msgstr "Geçersiz istek."

msgid "The report could not be read."
msgstr "Rapor okunamadı."

msgid "The report is too large."
msgstr "Rapor çok büyük."

msgid "Too many reports were sent; please try again later."
msgstr "Çok fazla rapor gönderildi, lütfen daha sonra deneyin."

msgid "The server is not accepting reports right now; please try again later."
msgstr "Sunucu şu an rapor kabul etmiyor, lütfen daha sonra deneyin."

msgid "Input ended; no report was created."
msgstr "Girdi sona erdi, rapor oluşturulmadı."

msgid "This is required."
msgstr "Bu bilgi gerekli."

msgid "Enter a number (or press Enter to skip)."
msgstr "Sayı girin (boş bırakmak için Enter)."

msgid "Enter a number between 1 and {count}."
msgstr "1 ile {count} arasında bir sayı girin."

msgid "y"
msgstr "e"

msgid "n"
msgstr "h"

msgid "Sending to a server is disabled in this installation (TARTIM_REPORT_URL is empty)."
msgstr "Sunucuya gönderim bu kurulumda kapalı (TARTIM_REPORT_URL boş)."

msgid "The server did not accept the report (HTTP {status})."
msgstr "Sunucu raporu kabul etmedi (HTTP {status})."

msgid ""
"Could not reach the report server. Check your internet connection; the report "
"file is still on your computer and can be sent later."
msgstr ""
"Rapor sunucusuna ulaşılamadı. İnternet bağlantınızı kontrol edin; rapor "
"dosyası bilgisayarınızda duruyor, daha sonra yeniden gönderebilirsiniz."

msgid "Weight shown on the display (optional)"
msgstr "Ekranda görünen kilo (boş geçebilirsiniz)"

msgid "Decoded values:"
msgstr "Çözülen değerler:"

msgid ""
"The record is not in a known format. The values on the display will help us "
"decode it."
msgstr ""
"Kayıt bilinen biçimde değil. Ekrandaki değerler biçimi çözmemize yardım "
"edecek."

msgid "Values you entered on the device before measuring (leave empty if unsure):"
msgstr "Ölçümden önce cihaza girdiğiniz bilgiler (bilmiyorsanız boş bırakın):"

msgid "Results shown on the device display or printout (optional):"
msgstr "Cihaz ekranında (ya da çıktıda) gördüğünüz sonuçlar (boş bırakılabilir):"

msgid "Comparison: {ok} of {count} value matched the expected field."
msgid_plural "Comparison: {ok} of {count} values matched the expected field."
msgstr[0] "Karşılaştırma: {count} değerden {ok} tanesi beklenen alanla eşleşti."
msgstr[1] "Karşılaştırma: {count} değerden {ok} tanesi beklenen alanla eşleşti."

msgid "Port: {port}"
msgstr "Port: {port}"

msgid "Serial ports found:"
msgstr "Bulunan seri portlar:"

msgid "No serial port found. Plug in the cable and check with 'lsusb'."
msgstr "Seri port bulunamadı. Kabloyu takıp 'lsusb' ile kontrol edin."

msgid "Port (number or path, e.g. /dev/ttyUSB0)"
msgstr "Port (numara ya da yol, ör. /dev/ttyUSB0)"

msgid "No Bluetooth device found. Turn the scale on and try again."
msgstr "Bluetooth cihazı bulunamadı. Tartıyı açıp tekrar deneyin."

msgid "Bluetooth devices found:"
msgstr "Bulunan Bluetooth cihazları:"

msgid "(no name)"
msgstr "(adsız)"

msgid "Which one is your scale? (number)"
msgstr "Tartınız hangisi? (numara)"

msgid "Turn the scale on. Scanning for nearby Bluetooth devices (10 s)..."
msgstr "Tartıyı açın. Yakındaki Bluetooth cihazları taranıyor (10 sn)..."

msgid "Connected to {name}. Take a measurement on the device now..."
msgstr "{name} bağlandı. Şimdi cihazda ölçüm yapın..."

msgid "Data received ({count} bytes)."
msgstr "Veri alındı ({count} bayt)."

msgid "No data received."
msgstr "Hiç veri gelmedi."

msgid "Connecting to {name}..."
msgstr "{name} ile bağlantı kuruluyor..."

msgid "the device"
msgstr "cihaz"

msgid "Connected. Take a measurement on the device now (waiting up to {seconds} s)..."
msgstr "Bağlandı. Şimdi cihazda ölçüm yapın (en fazla {seconds} sn)..."

msgid "{count} Bluetooth notification received."
msgid_plural "{count} Bluetooth notifications received."
msgstr[0] "{count} Bluetooth bildirimi alındı."
msgstr[1] "{count} Bluetooth bildirimi alındı."

msgid ""
"No notifications arrived. The device may be waiting for a command from its app "
"before sending data; the report still contains its service structure."
msgstr ""
"Hiç bildirim gelmedi. Bu cihaz, veri göndermeden önce uygulamadan komut "
"bekliyor olabilir; rapor yine de cihazın servis yapısını içeriyor."

msgid "=== tartim device report ==="
msgstr "=== tartim cihaz raporu ==="

msgid "A report file will be prepared so that we can learn your device's data format."
msgstr "Cihazınızın veri biçimini öğrenmemiz için bir rapor dosyası hazırlanacak."

msgid "The client number is masked. Measure yourself or a test person."
msgstr "Danışan numarası maskelenir. Ölçümü kendinizle ya da bir test kişisiyle yapın."

msgid "Device model (on the label, e.g. MC-780MA)"
msgstr "Cihaz modeli (etikette yazar, ör. MC-780MA)"

msgid "Brand"
msgstr "Marka"

msgid "Device software version (if known)"
msgstr "Cihaz yazılım sürümü (biliyorsanız)"

msgid "PC data output setting (if known, e.g. 'default' or 'BC-418')"
msgstr "PC veri çıkış ayarı (biliyorsanız, ör. 'varsayılan' ya da 'BC-418')"

msgid "Connection type:"
msgstr "Bağlantı türü:"

msgid "Your choice"
msgstr "Seçiminiz"

msgid "Path of the file on the SD card"
msgstr "SD karttaki dosyanın yolu"

msgid "Could not read {path}: {error}"
msgstr "{path} okunamadı: {error}"

msgid "{name} read."
msgstr "{name} okundu."

msgid "Baud rate"
msgstr "Baud hızı"

msgid "How many measurements should be recorded?"
msgstr "Kaç ölçüm kaydedilsin?"

msgid "Take a measurement on the device now. Waiting (up to {seconds} s)..."
msgstr "Şimdi cihazda ölçüm yapın. Bekleniyor (en fazla {seconds} sn)..."

msgid "No data received. Check the cable and the device's PC output setting."
msgstr "Hiç veri gelmedi. Kabloyu ve cihazın PC çıkış ayarını kontrol edin."

msgid "To try another speed: tartim report --baud 19200"
msgstr "Farklı bir hız denemek için: tartim rapor --baud 19200"

msgid "Anything you want to add (problems, device settings etc.)"
msgstr "Eklemek istediğiniz not (sorunlar, cihaz ayarları vb.)"

msgid "Report saved: {path}"
msgstr "Rapor kaydedildi: {path}"

msgid "How would you like to send the report?"
msgstr "Raporu nasıl göndermek istersiniz?"

msgid "Does this measurement belong to you or a test person (not a real client)?"
msgstr "Bu ölçüm gerçek bir danışana değil, size ya da bir test kişisine mi ait?"

msgid ""
"Measurements of real clients are not sent. Please take a new measurement of "
"yourself or a test person."
msgstr ""
"Gerçek danışan ölçümleri gönderilmez. Lütfen kendinizle ya da bir test "
"kişisiyle yeni bir ölçüm yapın."

msgid "A short note (optional)"
msgstr "Eklemek istediğiniz kısa bir not (isteğe bağlı)"

msgid "Could not send: {error}"
msgstr "Gönderilemedi: {error}"

msgid "To try again later: tartim send-report {path}"
msgstr "Daha sonra yeniden denemek için: tartim rapor-gonder {path}"

msgid "Sent, thank you! Your report number: {id}"
msgstr "Gönderildi, teşekkürler! Rapor numaranız: {id}"

msgid "Open the form at this address and drag the file into the “Report file” box:"
msgstr "Şu adresteki formu açın, dosyayı “Rapor dosyası” kutusuna sürükleyin:"

msgid "The report stays on your computer. To send it later:"
msgstr "Rapor bilgisayarınızda kaldı. Daha sonra göndermek için:"

msgid "or send the file with the GitHub form: {url}"
msgstr "ya da dosyayı GitHub formuyla gönderin: {url}"

msgid "Could not read the report file: {error}"
msgstr "Rapor dosyası okunamadı: {error}"

msgid "Measurements of real clients are not sent."
msgstr "Gerçek danışan ölçümleri gönderilmez."

msgid "Cancelled; no report was created."
msgstr "İptal edildi, rapor oluşturulmadı."

msgid "[unrecognized record] {raw}"
msgstr "[tanınmayan kayıt] {raw}"

msgid "We do not know this format. Please share the output of 'tartim raw' with the project."
msgstr "Bu biçimi tanımıyoruz. Lütfen 'tartim ham' çıktısını proje ile paylaşın."

msgid "Measurement: {model}  client: {client}"
msgstr "Ölçüm: {model}  danışan: {client}"

msgid "(* the meaning of this field has not been verified on a real device yet)"
msgstr "(* alan anlamı henüz gerçek cihazla doğrulanmadı)"

msgid "e.g. /dev/ttyUSB0"
msgstr "ör. /dev/ttyUSB0"

msgid "default: {value}"
msgstr "varsayılan: {value}"

msgid "No serial port found. Plug in the USB-serial adapter and check with 'lsusb'."
msgstr "Seri port bulunamadı. USB-seri çeviriciyi takıp 'lsusb' ile kontrol edin."

msgid "Listening on {port} ({settings}). Press Ctrl+C to quit."
msgstr "{port} dinleniyor ({settings}). Çıkmak için Ctrl+C."

msgid "Recording raw data. Take a measurement on the device; press Ctrl+C to quit."
msgstr "Ham veri kaydediliyor. Cihazda bir ölçüm yapın; çıkmak için Ctrl+C."

