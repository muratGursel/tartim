msgstr "Kaydedilmiş bir raporu proje sunucusuna gönder"

msgid "Short note (optional)"
msgstr "Kısa not (isteğe bağlı)"

msgid "Virtual scale: send synthetic measurements to a port"
msgstr "Sanal tartı: porta sentetik ölçüm gönder"

msgid "seconds"
msgstr "saniye"

msgid "For repeatable values"
msgstr "Tekrarlanabilir değerler için"

msgid "COMMAND"
msgstr "KOMUT"

msgid "Not connected. Choose the port and press “Connect”."
msgstr "Bağlı değil. Portu seçip “Bağlan”a basın."

