msgstr "Ölçüm zamanı"

msgid "Model"
msgstr "Model"

msgid "Client"
msgstr "Danışan"

msgid "{n} measurement written to {path}."
msgid_plural "{n} measurements written to {path}."
msgstr[0] "{n} ölçüm {path} dosyasına yazıldı."
msgstr[1] "{n} ölçüm {path} dosyasına yazıldı."

msgid "Scanning ({seconds} s)... Make sure the scale is turned on."
msgstr "Taranıyor ({seconds} sn)... Tartının açık olduğundan emin olun."

